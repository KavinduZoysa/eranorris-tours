{
  "name": "eranorris-tours",
  "version": "1.0.0",
  "private": true,
  "description": "Map-first private tour planner for Sri Lanka — static site",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:staging": "SITE_ENV=staging node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && npm run check",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "prepare:images": "node scripts/prepare-images.mjs",
    "prepare:geo": "node scripts/prepare-geo.mjs",
    "prepare:fonts": "node scripts/prepare-fonts.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "marked": "18.1.1",
    "node-html-parser": "9.0.4",
    "sharp": "0.35.5",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  }
}
